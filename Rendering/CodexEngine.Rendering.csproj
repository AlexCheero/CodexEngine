<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EffectsDir>$(MSBuildProjectDirectory)\obj\effects\$(Configuration)</EffectsDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Runtime/CodexEngine.Runtime.csproj" />
    <ProjectReference Include="../ThirdParty/FNA/FNA.Core.csproj" />
    <Content Include="../ThirdParty/FNA/native/win-x64/*.dll"
             Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ThirdParty/FNA/Notices/*.txt"
             Link="Content/Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(EffectsDir)\Surface.fxb;$(EffectsDir)\Character.fxb;$(EffectsDir)\AmbientOcclusion.fxb"
             Link="Content/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ShaderSource Include="Shaders/*.fx;Shaders/*.hlsl" />
  </ItemGroup>
  <Target Name="CompileFnaEffects" BeforeTargets="PrepareForBuild"
          Inputs="@(ShaderSource);$(MSBuildProjectDirectory)\CompileEffects.ps1;$(MSBuildProjectFullPath)"
          Outputs="$(EffectsDir)\Surface.fxb;$(EffectsDir)\Character.fxb;$(EffectsDir)\AmbientOcclusion.fxb">
    <Exec Command="powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\CompileEffects.ps1&quot; -SourceDirectory &quot;$(MSBuildProjectDirectory)\Shaders&quot; -OutputDirectory &quot;$(EffectsDir)&quot;" />
  </Target>
</Project>
